{
  "manifest_version": 3,
  "name": "xbkmrk — Save to archive",
  "version": "1.0",
  "description": "Save the current page (and selected quote) to your self-hosted bookmark archive.",
  "action": { "default_title": "Save to archive" },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save current page to archive"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
