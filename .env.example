# Postgres (dedicated pgvector container)
DB_PASSWORD=change_me
# Optional separate password for the read-only MCP role (defaults to DB_PASSWORD if unset)
MCP_DB_PASSWORD=

# X API (create an app in the X developer console; OAuth2 user-context client)
X_CLIENT_ID=
X_CLIENT_SECRET=
# optional cache; otherwise resolved via /2/users/me
X_USER_ID=
# Callback URL registered on the X app for the one-time PKCE flow
X_REDIRECT_URI=http://localhost:3022/callback

# Embeddings (OpenAI-compatible endpoint, e.g. LM Studio / Ollama)
# Must be reachable FROM INSIDE the containers — use host.docker.internal for a
# server on this machine, or a LAN/Tailscale IP. Never plain localhost.
EMBEDDING_API_URL=http://host.docker.internal:1234/v1/embeddings
# if the endpoint requires auth (LM Studio API token)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Poller schedule (cron). Leave empty to disable scheduled polling and sync
# only when the app is opened (see SYNC_ON_ACCESS_HOURS) — saves X API credits.
SYNC_CRON=0 */4 * * *
# Opening the web app triggers a sync when the last one is older than this
# many hours (0 disables sync-on-open)
SYNC_ON_ACCESS_HOURS=6

# Likes ingestion (needs the like.read OAuth scope — re-run `npm run auth` after enabling)
SYNC_LIKES=true
LIKES_MAX_AGE_DAYS=60

# Optional: lifts GitHub API rate limit for README enrichment (60/h -> 5000/h)
GITHUB_TOKEN=

# Optional: free Reddit "script" app (https://www.reddit.com/prefs/apps) —
# saved reddit links then get the post body, image/video, and top comments
# (reddit blocks anonymous scraping). Also editable later in Settings.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Auto-tagging: chat model on the same LM Studio host (empty = disabled)
TAGGING_MODEL=qwen/qwen3.5-9b
# Alternative tagging backend: LLM_PROVIDER=codex uses the Codex CLI instead of
# LM Studio — also copy docker-compose.override.example.yml to
# docker-compose.override.yml to mount its auth (CODEX_MODEL/CODEX_SANDBOX optional)
LLM_PROVIDER=lmstudio

# Host ports (change here if already taken on your host)
WEB_PORT=3020
MCP_PORT=3021
DB_INSPECT_PORT=5433
